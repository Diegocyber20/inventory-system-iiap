# Puerto en el que correrá el backend
PORT=3000

# URL de conexión para la base de datos PostgreSQL
# En desarrollo local con Docker Compose, "db" es el nombre del servicio de la base de datos.
DATABASE_URL="postgresql://postgres:postgres123@db:5432/inventory_db?schema=public"

# URL para desarrollo local sin Docker Compose (descomentar si se corre local):
# DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/inventory_db?schema=public"
